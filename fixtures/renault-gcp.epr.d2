userPub -> okta
userInt -> okta
userInt -> cdn
apigee -> gw1
apigee -> gw2
gw1 -> app1
gw2 -> app2
app1 -> cloudsql
cdn -> webstore
aem -> argo
aem -> datastore
functions -> cloudsql
gitlab -> argo: "Manages" { style.stroke-dash: 4 }
gitlab -> functions { style.stroke-dash: 4 }
gitlab -> datastore { style.stroke-dash: 4 }

