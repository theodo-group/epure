+// Épure patch — libavoid routing checkpoints. An edge whose ELK JSON carries
+// `properties.checkpoints: [{x, y}]` (absolute coordinates, in order) gets them
+// as mandatory waypoints on its connector: libavoid then routes through each
+// point in sequence instead of taking the shortest obstacle-free path.
+function applyRoutingCheckpoints(Avoid, connRef, properties) {
+	const checkpoints = properties && properties.checkpoints;
+	if (!Array.isArray(checkpoints) || checkpoints.length === 0) return;
+	const vector = new Avoid.CheckpointVector();
+	for (const p of checkpoints) {
+		if (!p || typeof p.x !== "number" || typeof p.y !== "number") continue;
+		vector.push_back(new Avoid.Checkpoint(new Avoid.Point(p.x, p.y)));
+	}
+	connRef.setRoutingCheckpoints(vector);
+}
