{
  "name": "@theodo-group/epure",
  "version": "0.7.0",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Grid-snapped, orthogonal-routed architecture-diagram editor that lives in your repo as a reviewable file pair and is driven live by Claude Code.",
  "keywords": [
    "architecture",
    "diagram",
    "d2",
    "claude-code",
    "claude",
    "editor",
    "svg",
    "orthogonal-routing"
  ],
  "homepage": "https://github.com/theodo-group/epure#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theodo-group/epure.git"
  },
  "bugs": {
    "url": "https://github.com/theodo-group/epure/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "epure": "dist-server/epure.mjs"
  },
  "exports": {
    "./render": {
      "types": "./dist-lib/render.d.ts",
      "default": "./dist-lib/render.js"
    },
    "./react": {
      "types": "./dist-lib/react.d.ts",
      "default": "./dist-lib/react.js"
    },
    "./icons": {
      "types": "./dist-lib/icons.d.ts",
      "default": "./dist-lib/icons.js"
    },
    "./bridge": {
      "types": "./dist-lib/bridge.d.ts",
      "default": "./dist-lib/bridge.js"
    },
    "./icons/files/*": "./dist/icons/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-lib",
    "dist-server",
    "skills"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:node": "tsdown",
    "build:all": "npm run build && npm run build:node",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "npm run build:all"
  },
  "dependencies": {
    "@mr_mint/elkjs-libavoid": "^0.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "chokidar": "^5.0.0",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  }
}
