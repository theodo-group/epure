{
  "name": "epure",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "A grid-snapped, orthogonal-routed architecture-diagram editor that reads and writes a tiny D2 subset.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "epure": "dist-server/epure.mjs"
  },
  "files": [
    "dist",
    "dist-server",
    "skills"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:all": "pnpm build && pnpm build:server",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build:all"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.2",
    "@lezer/highlight": "^1.2.3",
    "@mr_mint/elkjs-libavoid": "^0.3.0",
    "chevrotain": "^11.0.3",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.1",
    "elkjs": "^0.10.0",
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "sirv": "^3.0.2",
    "svg-pan-zoom": "^3.6.2",
    "ws": "^8.21.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "^1.91.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "simple-icons": "^16.24.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
