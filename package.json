{
  "name": "@theodo-group/epure",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Grid-snapped, orthogonal-routed architecture-diagram editor that lives in your repo as a reviewable file pair and is driven live by Claude Code.",
  "keywords": [
    "architecture",
    "diagram",
    "d2",
    "claude-code",
    "claude",
    "editor",
    "svg",
    "orthogonal-routing"
  ],
  "homepage": "https://github.com/theodo-group/epure#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theodo-group/epure.git"
  },
  "bugs": {
    "url": "https://github.com/theodo-group/epure/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "epure": "dist-server/epure.mjs"
  },
  "exports": {
    "./render": {
      "types": "./dist-lib/render.d.ts",
      "default": "./dist-lib/render.js"
    },
    "./react": {
      "types": "./dist-lib/react.d.ts",
      "default": "./dist-lib/react.js"
    },
    "./icons": {
      "types": "./dist-lib/icons.d.ts",
      "default": "./dist-lib/icons.js"
    },
    "./bridge": {
      "types": "./dist-lib/bridge.d.ts",
      "default": "./dist-lib/bridge.js"
    },
    "./icons/files/*": "./dist/icons/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-lib",
    "dist-server",
    "skills"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:lib": "tsup",
    "build:all": "npm run build && npm run build:server && npm run build:lib",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "npm run build:all"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.2",
    "@lezer/highlight": "^1.2.3",
    "@mr_mint/elkjs-libavoid": "^0.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "chevrotain": "^11.0.3",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.1",
    "elkjs": "^0.10.0",
    "fflate": "^0.8.2",
    "react-resizable-panels": "^2.1.7",
    "sirv": "^3.0.2",
    "svg-pan-zoom": "^3.6.2",
    "ws": "^8.21.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@lobehub/icons-static-svg": "^1.91.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.24.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
